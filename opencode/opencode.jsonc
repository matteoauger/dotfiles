{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "date *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "wc *": "allow",

      "git *": "ask",
      "git diff *": "allow",
      "git status *": "allow",

      // Windows
      "Get-*": "allow",
      "Select-String *": "allow"
    },
    "chrome-devtools_*": "allow"
    // "YouTrack_*": "ask",
    //  "postgres_*": "ask",
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
    // "YouTrack": {
    //   "type": "remote",
    //   "url": "https://youtrack.com/mcp",
    //   "headers": {
    //       "Authorization": "Bearer <TOKEN>"
    //   }
    // },
    // "postgres": {
    //    "type": "local",
    //    "command": [ 
		// "podman",         
    //     	"run",
    //     	"-i",
    //     	"--rm",
    //     	"-e",
    //     	"DATABASE_URI",
    //     	"crystaldba/postgres-mcp",
    //     	"--access-mode=restricted"
    //    ],
    //    "environment": {
    //        "DATABASE_URI": "postgresql://<USER>:<PASSWORD>@127.0.0.1:5432/<database>",
    //    },
    // },
  }
}
